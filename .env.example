# Optional features — leave blank to hide the related UI
# (The Ko-fi webhook token is server-only: see server/kofi.env.example — never put it in VITE_*)
# VITE_TIP_URL defaults to https://ko-fi.com/veyth; set it empty to hide the Ko-fi buttons
# VITE_TIP_URL=https://ko-fi.com/veyth
# Public source repo (GitHub) — enables "suggest a tool", "view source", contributor links
# VITE_REPO_URL=https://github.com/you/veyth
# VITE_STRIPE_LINK=https://buy.stripe.com/xxx
# VITE_AD_CLIENT=ethicalads-or-carbon-id

# Canonical URL for OG tags (default https://veyth.eu)
# VITE_SITE_URL=https://veyth.eu
